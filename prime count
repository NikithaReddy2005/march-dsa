# prime count-BRUTE FORCE APPORACH
class Solution:
    def countPrimes(self, n: int) -> int:
        def isprime(n):
            cnt=0                                    #T.C=O(N**2)
            for i  in range(1,n+1):
                if(n%i==0):
                    cnt+=1
            return cnt
        count=0
        for i in range(2,n):
            if(isprime(i)==2):
                count+=1
        return count
        
