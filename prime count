#optimal apporach -Sieve of Eratosthenes 
class Solution:
    def countPrimes(self, n: int) -> int:
        arr=[1]*n
        cnt=0                                   #T.C: O(N log logN)
        for i in range(2,n):                    #S.C: O(N)
            if(arr[i]==1):
                cnt+=1
                for j in range(i*i,n,i):       # only makes it as multiples if and only if the number is prime here because non prime number multiples are already made 0 by their smaller numbers
                    arr[j]=0
        return cnt

